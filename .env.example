# AssemblyAI API key (https://www.assemblyai.com/dashboard) — used server-side only
ASSEMBLYAI_API_KEY=your_key_here

# Optional: override the LLM Gateway models (defaults: claude-haiku-4-5-20251001 / claude-sonnet-4-6).
# Your AssemblyAI account must be entitled to the models on https://www.assemblyai.com/docs/llm-gateway/available-models
# EARSHOT_FAST_MODEL=claude-haiku-4-5-20251001
# EARSHOT_SMART_MODEL=claude-sonnet-4-6

# LLM provider for the policy / correction parser / distillation.
# "assemblyai" = AssemblyAI LLM Gateway (needs Claude model entitlement on your account).
# "gemini"     = Google Gemini through its OpenAI-compatible endpoint (auto-selected when GEMINI_API_KEY is set).
# EARSHOT_LLM_PROVIDER=assemblyai
# GEMINI_API_KEY=
